# OpenStack/cPouta Configuration
# Copy this file to terraform.tfvars and fill in your values

# Image name (run: openstack image list)
# Common options: Ubuntu-24.04, Ubuntu-22.04, Ubuntu-20.04
image_name = "Ubuntu-24.04"

# Network name (run: openstack network list)
# This is usually your project network, format: project_XXXXXXX
network_name = "project_2011111"

# Flavor names (run: openstack flavor list)
# Common cPouta flavors:
#   standard.tiny     - 1 vCPU, 1GB RAM
#   standard.small    - 2 vCPU, 2GB RAM  ← Quota-friendly
#   standard.medium   - 3 vCPU, 4GB RAM
#   standard.large    - 4 vCPU, 8GB RAM
#   standard.xlarge   - 6 vCPU, 15GB RAM
#   standard.xxlarge  - 8 vCPU, 31GB RAM
#   standard.3xlarge  - 8 vCPU, 62GB RAM

# Quota-friendly defaults (2+2+2 = 6 cores total, fits 8 core limit)
controller_flavor = "standard.small"
worker_flavor     = "standard.small"

# Number of worker nodes (default: 2 to fit quota)
worker_count = 3

# Floating IPs for workers (disabled by default to save floating IP quota)
# Controller always gets a floating IP. Workers accessed via controller bastion.
# Set to true if you have floating IP quota and want direct worker access.
assign_worker_floating_ips = false

# SSH configuration
ssh_public_key_path  = "~/.ssh/id_rsa.pub"
ssh_private_key_path = "~/.ssh/id_rsa"

# SSH user for Ubuntu images (usually 'ubuntu')
# For other images, might be 'cloud-user', 'centos', 'debian', etc.
ssh_user = "ubuntu"

# Additional storage volumes (100GB each)
# Set to false for initial deployment to use only default instance storage
# Set to true later if you need additional storage mounted at /var/lib/k0s
enable_additional_storage = true 

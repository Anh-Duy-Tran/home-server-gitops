# Voice Assistant Environment Variables Template
# Copy this file to .env and fill in your values
# cp .env.template .env

# =============================================================================
# MQTT Configuration
# =============================================================================
MQTT_BROKER=mosquitto.voice-assistant.svc.cluster.local
MQTT_PORT=1883
MQTT_TOPIC=home/voice/commands

# For local development, use localhost if MQTT is port-forwarded:
# MQTT_BROKER=localhost
# kubectl port-forward -n voice-assistant svc/mosquitto 1883:1883

# =============================================================================
# STT Backend Selection
# =============================================================================
# Options: vosk, groq, openrouter
# See STT_BACKENDS.md for detailed comparison
STT_BACKEND=vosk

# =============================================================================
# STT API Keys (Cloud Backends Only)
# =============================================================================
# Leave empty if using vosk (local)

# Groq API Key (Recommended - Free tier: 10k requests/month)
# Get from: https://console.groq.com/keys
STT_API_KEY=

# If using Groq, uncomment and set:
# STT_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# If using OpenRouter, uncomment and set:
# STT_API_KEY=sk-or-v1-YOUR_OPENROUTER_API_KEY_HERE

# =============================================================================
# STT Model Override (Optional)
# =============================================================================
# Leave empty to use defaults:
# - Groq: whisper-large-v3
# - OpenRouter: openai/whisper-large-v3
STT_MODEL=

# To use a different model:
# Groq: STT_MODEL=whisper-large-v3-turbo
# OpenRouter: STT_MODEL=openai/whisper-1

# =============================================================================
# Audio Configuration
# =============================================================================
SAMPLE_RATE=16000
WAKE_PHRASES=hey assistant,hey wolt,ok assistant
POST_WAKE_RECORD_SECONDS=3.0

# Adjust recording time if commands are cut off or too long:
# POST_WAKE_RECORD_SECONDS=2.0  # Shorter, faster
# POST_WAKE_RECORD_SECONDS=4.0  # Longer, for slow speakers

# =============================================================================
# Metadata
# =============================================================================
USER=duy
SOURCE=k8s-voice-assistant

# For local testing:
# SOURCE=local-dev

# =============================================================================
# Vosk Model Path (Local STT Only)
# =============================================================================
VOSK_MODEL_PATH=/models/vosk-model

# For local development with downloaded model:
# VOSK_MODEL_PATH=/path/to/vosk-model-small-en-us-0.15

# =============================================================================
# Development/Testing
# =============================================================================
# Uncomment for debug logging:
# LOG_LEVEL=DEBUG

# Test without microphone (reads from file):
# AUDIO_FILE=/path/to/test.wav

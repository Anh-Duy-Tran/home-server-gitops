# Kubernetes Secrets Template for Voice Assistant
#
# IMPORTANT: This is a TEMPLATE file (safe to commit to git)
#
# To use:
# 1. Copy this file: cp secrets.yaml.template secrets.yaml
# 2. Fill in your actual API key in secrets.yaml
# 3. Apply: kubectl apply -f manifests/secrets.yaml
#
# NOTE: secrets.yaml is in .gitignore and will NOT be committed
#
# Alternative (recommended for production):
# Use kubectl to create the secret directly (no file on disk):
#   kubectl create secret generic voice-agent-secret \
#     --from-literal=STT_API_KEY='your-actual-api-key-here' \
#     -n voice-assistant

---
apiVersion: v1
kind: Secret
metadata:
  name: voice-agent-secret
  namespace: voice-assistant
  labels:
    app.kubernetes.io/name: voice-assistant
    app.kubernetes.io/component: voice-control
type: Opaque
stringData:
  # STT API Key for cloud backends (Groq or OpenRouter)
  #
  # If using Vosk (local STT): Leave empty or use any dummy value
  # If using Groq: Get key from https://console.groq.com/keys
  #   Format: gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
  # If using OpenRouter: Get key from https://openrouter.ai/keys
  #   Format: sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

  STT_API_KEY: ""  # REPLACE WITH YOUR ACTUAL API KEY

# Examples (DO NOT COMMIT WITH REAL KEYS):
#
# For Groq:
#   STT_API_KEY: "gsk_1234567890abcdefghijklmnopqrstuvwxyz"
#
# For OpenRouter:
#   STT_API_KEY: "sk-or-v1-1234567890abcdefghijklmnopqrstuvwxyz"
#
# For Vosk (no key needed):
#   STT_API_KEY: ""
